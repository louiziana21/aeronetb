# AeroNetB Backend Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL (e.g. Render free tier)
PG_HOST=your-pg-host.render.com
PG_PORT=5432
PG_DATABASE=aeronetb
PG_USER=aeronetb_user
PG_PASSWORD=your_pg_password
PG_SSL=true

# MongoDB (MongoDB Atlas free tier)
MONGO_URI=mongodb+srv://aeronetb_user:your_mongo_password@cluster0.xxxxx.mongodb.net/aeronetb?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# Server
PORT=3000
NODE_ENV=production
FRONTEND_ORIGIN=https://your-frontend.onrender.com
